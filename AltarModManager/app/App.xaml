<Application x:Class="Altar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>

    <!-- palette (same as the old tkinter app and the in-game menu) -->
    <Color x:Key="C.Bg">#120d1c</Color>
    <Color x:Key="C.Panel">#1a1329</Color>
    <Color x:Key="C.Card">#251c3d</Color>
    <Color x:Key="C.CardHi">#322652</Color>
    <Color x:Key="C.Border">#3a2d60</Color>
    <Color x:Key="C.Accent">#a866ff</Color>
    <Color x:Key="C.Accent2">#6f8bff</Color>
    <SolidColorBrush x:Key="B.Bg" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="B.Panel" Color="{StaticResource C.Panel}"/>
    <SolidColorBrush x:Key="B.Card" Color="{StaticResource C.Card}"/>
    <SolidColorBrush x:Key="B.CardHi" Color="{StaticResource C.CardHi}"/>
    <SolidColorBrush x:Key="B.Border" Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="B.Gold" Color="#ffc640"/>
    <SolidColorBrush x:Key="B.Green" Color="#59ff80"/>
    <SolidColorBrush x:Key="B.Red" Color="#ff5a66"/>
    <SolidColorBrush x:Key="B.Danger" Color="#5a2238"/>
    <SolidColorBrush x:Key="B.Text" Color="#f4efff"/>
    <SolidColorBrush x:Key="B.Sub" Color="#a39bb8"/>
    <SolidColorBrush x:Key="B.Dim" Color="#6b6385"/>
    <LinearGradientBrush x:Key="B.AccentGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="{StaticResource C.Accent}" Offset="0"/>
      <GradientStop Color="{StaticResource C.Accent2}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.PlayGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#ffd866" Offset="0"/>
      <GradientStop Color="#ff9d3d" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="F.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <CubicEase x:Key="Ease" EasingMode="EaseOut"/>

    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource F.Icon}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource F.Display}"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource B.Sub}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource B.Card}"/>
      <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- buttons: Tag holds an optional icon glyph -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource B.CardHi}"/>
      <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform">
        <Setter.Value><ScaleTransform/></Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
              <Border x:Name="hl" Background="White" Opacity="0" CornerRadius="8"/>
              <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ic" Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" Margin="0,0,8,0"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="{x:Null}">
                <Setter TargetName="ic" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="ic" Property="Margin" Value="0"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="hl" Property="Opacity" Value="0.09"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="hl" Property="Opacity" Value="0.18"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.95" Duration="0:0:0.08"/>
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.95" Duration="0:0:0.08"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource Ease}"/>
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource Ease}"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.15"/>
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.15"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Btn.Accent" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource B.AccentGrad}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Btn.Green" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource B.Green}"/>
      <Setter Property="Foreground" Value="{StaticResource B.Bg}"/>
    </Style>
    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource B.Danger}"/>
      <Setter Property="Foreground" Value="#ffd7dc"/>
    </Style>
    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource B.Sub}"/>
    </Style>

    <!-- window caption buttons -->
    <Style x:Key="Caption" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Foreground" Value="{StaticResource B.Sub}"/>
      <Setter Property="FontFamily" Value="{StaticResource F.Icon}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#18ffffff"/>
                <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Caption.Close" TargetType="Button" BasedOn="{StaticResource Caption}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#c42b1c"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- animated on/off switch -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Width="44" Height="22" Background="Transparent">
              <Border x:Name="track" CornerRadius="11" Background="{StaticResource B.Bg}"
                      BorderBrush="{StaticResource B.Sub}" BorderThickness="1"/>
              <Ellipse x:Name="knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="5,0,0,0"
                       Fill="{StaticResource B.Sub}" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform/>
                    <TranslateTransform/>
                  </TransformGroup>
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="knob" Duration="0:0:0.2" To="22" EasingFunction="{StaticResource Ease}"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"/>
                      <DoubleAnimation Storyboard.TargetName="knob" Duration="0:0:0.2" To="1.25" EasingFunction="{StaticResource Ease}"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"/>
                      <DoubleAnimation Storyboard.TargetName="knob" Duration="0:0:0.2" To="1.25" EasingFunction="{StaticResource Ease}"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="knob" Duration="0:0:0.2" To="0" EasingFunction="{StaticResource Ease}"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"/>
                      <DoubleAnimation Storyboard.TargetName="knob" Duration="0:0:0.2" To="1" EasingFunction="{StaticResource Ease}"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"/>
                      <DoubleAnimation Storyboard.TargetName="knob" Duration="0:0:0.2" To="1" EasingFunction="{StaticResource Ease}"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter TargetName="track" Property="Background" Value="{StaticResource B.AccentGrad}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                <Setter TargetName="knob" Property="Fill" Value="White"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="IsChecked" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource B.Text}"/>
                <Setter TargetName="knob" Property="Fill" Value="{StaticResource B.Text}"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- sidebar navigation: Tag = icon glyph -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource B.Sub}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="10,2"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Height="42" Background="Transparent">
              <Border x:Name="bg" CornerRadius="8" Background="{StaticResource B.CardHi}" Opacity="0"/>
              <Border x:Name="bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                      Background="{StaticResource B.AccentGrad}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                  <ScaleTransform ScaleY="0"/>
                </Border.RenderTransform>
              </Border>
              <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="{TemplateBinding Tag}"/>
                <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                       To="1" Duration="0:0:0.25" EasingFunction="{StaticResource Ease}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                       To="0" Duration="0:0:0.15"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter TargetName="bg" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- filter chips -->
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource B.Sub}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="16" Padding="14,7" Background="{StaticResource B.Card}"
                    BorderBrush="{StaticResource B.Border}" BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.CardHi}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.AccentGrad}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource B.Text}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource B.Accent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{StaticResource B.CardHi}"/>
      <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource B.Bg}"/>
              <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                      Background="{StaticResource B.AccentGrad}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- slim scrollbars -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="th" CornerRadius="3" Margin="3,2" Background="{StaticResource B.Border}"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="th" Property="Background" Value="{StaticResource B.Dim}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
