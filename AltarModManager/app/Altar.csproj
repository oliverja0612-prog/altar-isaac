<Project Sdk="Microsoft.NET.Sdk">

  <!-- Altar Mod Manager (WPF). tools/build.py publishes it as one self-contained Altar.exe
       (single-file, win-x64, compressed). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Altar</AssemblyName>
    <RootNamespace>Altar</RootNamespace>
    <ApplicationIcon>..\assets\altar.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>Altar Mod Manager</Product>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- art generated by tools/make_sprites.py, embedded so the exe is self-contained -->
    <EmbeddedResource Include="..\assets\*.png" LinkBase="assets" />
    <!-- installer payload (mod files), passed by tools/build.py as -p:AltarPayload=...; without it
         the exe is just the Mod Manager -->
    <EmbeddedResource Include="$(AltarPayload)" LogicalName="payload.zip" Condition="'$(AltarPayload)' != ''" />
  </ItemGroup>

</Project>
