<Window x:Class="Altar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Altar"
        Title="Altar Mod Manager" Width="1180" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource B.Bg}"
        FontFamily="{StaticResource F.Ui}" Foreground="{StaticResource B.Text}"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter" DragLeave="Window_DragLeave"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>

    <!-- one installed mod -->
    <DataTemplate x:Key="ModCard" DataType="{x:Type local:ModVM}">
      <Border x:Name="card" CornerRadius="12" Margin="0,0,12,8" Padding="12" BorderThickness="1"
              Cursor="Hand" MouseLeftButtonDown="Card_MouseDown" Tag="{Binding}" RenderTransformOrigin="0.5,0.5">
        <Border.Background>
          <SolidColorBrush Color="{StaticResource C.Card}"/>
        </Border.Background>
        <Border.BorderBrush>
          <SolidColorBrush Color="{StaticResource C.Border}"/>
        </Border.BorderBrush>
        <Border.RenderTransform>
          <TranslateTransform/>
        </Border.RenderTransform>
        <Border.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" From="10" To="0" Duration="0:0:0.3"
                                 EasingFunction="{StaticResource Ease}"/>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
          <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
              <Storyboard>
                <ColorAnimation Storyboard.TargetProperty="Background.Color" To="{StaticResource C.CardHi}" Duration="0:0:0.15"/>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
          <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
              <Storyboard>
                <ColorAnimation Storyboard.TargetProperty="Background.Color" To="{StaticResource C.Card}" Duration="0:0:0.25"/>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Border.Triggers>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid Width="52" Height="52">
            <Border CornerRadius="10" Background="{Binding TileBrush}">
              <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border CornerRadius="10">
              <Border.Background>
                <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
              </Border.Background>
            </Border>
          </Grid>
          <StackPanel Grid.Column="1" Margin="14,2,12,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="name" Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold"
                         Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
              <Border CornerRadius="5" Background="#2259ff80" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Version}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource B.Green}"/>
              </Border>
              <Border CornerRadius="5" Background="#33a866ff" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding IsCore, Converter={StaticResource Vis}}">
                <TextBlock Text="&#x2726; CORE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource B.Accent}"/>
              </Border>
              <Border CornerRadius="5" Background="#33ffc640" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding Conflicted, Converter={StaticResource Vis}}" ToolTip="Replaces a file another enabled mod also replaces">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="10" Foreground="{StaticResource B.Gold}" Margin="0,0,4,0"/>
                  <TextBlock Text="CONFLICT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource B.Gold}"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{StaticResource B.Sub}"
                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
          </StackPanel>
          <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                        Margin="0,0,6,0" ToolTip="Enable / disable"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Enabled}" Value="False">
          <Setter TargetName="name" Property="Foreground" Value="{StaticResource B.Dim}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource B.AccentGrad}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Root">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ===== title bar ===== -->
      <Grid Background="{StaticResource B.Panel}">
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <Image x:Name="Logo" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="ALTAR" FontFamily="{StaticResource F.Display}" FontSize="18" FontWeight="Bold"
                     Margin="12,0,0,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="SubtitleText" Text="Mod Manager" Foreground="{StaticResource B.Dim}" FontSize="12.5"
                     Margin="12,3,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Border x:Name="SafePill" CornerRadius="10" Background="#2259ff80" Padding="9,3" Margin="0,0,12,0" VerticalAlignment="Center"
                  Visibility="Collapsed" ToolTip="Safe mode: runs played with mods don't count">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="11" Foreground="{StaticResource B.Green}" Margin="0,0,6,0"/>
              <TextBlock x:Name="SafePillText" Text="SAFE MODE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource B.Green}"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="CountText" Foreground="{StaticResource B.Sub}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <Button x:Name="PlayButton" Style="{StaticResource Btn}" Background="{StaticResource B.PlayGrad}" Foreground="#2a1600"
                  Tag="&#xE768;" Content="PLAY" FontWeight="Bold" FontSize="14" Padding="22,7" Margin="0,0,14,0"
                  VerticalAlignment="Center" Click="Play_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="Launch The Binding of Isaac"/>
          <Button Style="{StaticResource Caption}" Content="&#xE921;" Click="Min_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="MaxButton" Style="{StaticResource Caption}" Content="&#xE922;" Click="Max_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Style="{StaticResource Caption.Close}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
      </Grid>

      <!-- ===== update banner ===== -->
      <Border x:Name="UpdateBanner" Grid.Row="1" Background="{StaticResource B.Card}" Padding="20,10" Visibility="Collapsed"
              BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{StaticResource B.Accent}" FontSize="16"/>
          <TextBlock x:Name="UpdateText" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <ProgressBar x:Name="UpdateProgress" Grid.Column="2" Width="260" Maximum="1" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="210"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition x:Name="DetailsColumn" Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ===== sidebar ===== -->
        <Grid Background="{StaticResource B.Panel}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Margin="0,10,0,0">
            <RadioButton x:Name="NavInstalled" Style="{StaticResource Nav}" Tag="&#xE8F1;" Content="Installed" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavProfiles" Style="{StaticResource Nav}" Tag="&#xE8B7;" Content="Profiles" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavConflicts" Style="{StaticResource Nav}" Tag="&#xE7BA;" Content="Conflicts" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavItems" Style="{StaticResource Nav}" Tag="&#xE7FC;" Content="Altar Items" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Settings" Checked="Nav_Checked"/>
          </StackPanel>
          <Border Grid.Row="2" Margin="12" Padding="12,10" CornerRadius="10" Background="{StaticResource B.Card}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="GameDot" Width="8" Height="8" Fill="{StaticResource B.Green}" VerticalAlignment="Center"/>
                <TextBlock Text="Game folder" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource B.Sub}" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock x:Name="GameLabel" FontSize="11" Foreground="{StaticResource B.Dim}" TextWrapping="Wrap" Margin="0,4,0,0"
                         MaxHeight="46" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ===== pages ===== -->
        <Grid x:Name="PageHost" Grid.Column="1" Background="{StaticResource B.Bg}" ClipToBounds="True">

          <!-- Installed -->
          <Grid x:Name="PageInstalled" Margin="24,20,12,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,12,14">
              <TextBlock Style="{StaticResource H1}" Text="Installed mods"/>
              <TextBlock Style="{StaticResource Sub}" Text="Toggle mods on and off, install new ones, or drop a .zip anywhere on this window." Margin="0,4,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,12,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="SearchBorder" CornerRadius="10" Background="{StaticResource B.Card}" BorderThickness="1"
                      BorderBrush="{StaticResource B.Border}" Padding="12,0" Height="38">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource B.Sub}"/>
                  <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource Field}" Margin="10,0,0,0"
                           TextChanged="Search_Changed" GotFocus="Search_Focus" LostFocus="Search_Focus"/>
                  <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="Search mods..." Foreground="{StaticResource B.Dim}"
                             FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                <RadioButton Style="{StaticResource Chip}" GroupName="filter" Content="All" Tag="all" IsChecked="True" Checked="Filter_Checked"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="filter" Content="Enabled" Tag="on" Checked="Filter_Checked"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="filter" Content="Disabled" Tag="off" Checked="Filter_Checked"/>
              </StackPanel>
            </Grid>
            <WrapPanel Grid.Row="2" Margin="0,0,0,12">
              <Button Style="{StaticResource Btn.Accent}" Tag="&#xE710;" Content="Install .zip" Click="InstallZip_Click" Margin="0,0,8,0"/>
              <Button Style="{StaticResource Btn}" Tag="&#xE73E;" Content="Enable all" Click="EnableAll_Click" Margin="0,0,8,0"/>
              <Button Style="{StaticResource Btn}" Tag="&#xE711;" Content="Disable all" Click="DisableAll_Click" Margin="0,0,8,0"/>
              <Button Style="{StaticResource Btn}" Tag="&#xE838;" Content="Mods folder" Click="OpenMods_Click" Margin="0,0,8,0"/>
              <Button Style="{StaticResource Btn}" Tag="&#xE72C;" Content="Refresh" Click="Refresh_Click"/>
            </WrapPanel>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <ItemsControl x:Name="ModList" ItemTemplate="{StaticResource ModCard}"/>
                <StackPanel x:Name="EmptyMods" Margin="0,60,0,0" Visibility="Collapsed" HorizontalAlignment="Center">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="40" Foreground="{StaticResource B.Dim}" HorizontalAlignment="Center"/>
                  <TextBlock Text="No mods found" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,4" HorizontalAlignment="Center"/>
                  <TextBlock Style="{StaticResource Sub}" Text="Drop mod folders into the mods folder or use Install .zip." HorizontalAlignment="Center"/>
                </StackPanel>
                <Border Height="16"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- Profiles -->
          <Grid x:Name="PageProfiles" Margin="24,20,12,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,12,14">
              <TextBlock Style="{StaticResource H1}" Text="Profiles"/>
              <TextBlock Style="{StaticResource Sub}" Text="Save which mods are enabled and switch between setups in one click." Margin="0,4,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,12,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border CornerRadius="10" Background="{StaticResource B.Card}" BorderThickness="1" BorderBrush="{StaticResource B.Border}" Padding="14,0" Height="38">
                <Grid>
                  <TextBox x:Name="ProfileName" Style="{StaticResource Field}" KeyDown="ProfileName_KeyDown"/>
                  <TextBlock Text="Profile name, e.g. Boss rush" Foreground="{StaticResource B.Dim}" FontSize="14" Margin="2,0,0,0"
                             VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=ProfileName}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Border>
              <Button Grid.Column="1" Style="{StaticResource Btn.Accent}" Tag="&#xE74E;" Content="Save current" Margin="10,0,0,0" Click="SaveProfile_Click"/>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <ItemsControl x:Name="ProfileList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ProfileVM}">
                      <Border Style="{StaticResource Card}" Margin="0,0,12,8" Padding="16,12">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource B.AccentGrad}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="16" Foreground="White" HorizontalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{StaticResource B.Sub}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Green}" Tag="&#xE768;" Content="Apply" Click="ApplyProfile_Click" CommandParameter="{Binding Name}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource Btn.Danger}" Tag="&#xE74D;" Click="DeleteProfile_Click" CommandParameter="{Binding Name}" ToolTip="Delete profile"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyProfiles" Style="{StaticResource Sub}" Text="No profiles yet. Type a name and press Save current." Margin="0,24,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- Conflicts -->
          <Grid x:Name="PageConflicts" Margin="24,20,12,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,12,14">
              <TextBlock Style="{StaticResource H1}" Text="Conflicts"/>
              <TextBlock Style="{StaticResource Sub}" Text="Files that more than one enabled mod replaces. Only one version wins in game." Margin="0,4,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <ItemsControl x:Name="ConflictList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ConflictVM}">
                      <Border Style="{StaticResource Card}" Margin="0,0,12,6" Padding="14,10">
                        <StackPanel>
                          <TextBlock Text="{Binding File}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Foreground="{StaticResource B.Gold}"/>
                          <TextBlock Text="{Binding Owners}" FontSize="12" Foreground="{StaticResource B.Sub}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="NoConflicts" Margin="0,60,0,0" HorizontalAlignment="Center">
                  <Border Width="64" Height="64" CornerRadius="32" Background="#2259ff80" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="28" Foreground="{StaticResource B.Green}" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="No conflicts between enabled mods" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- Altar Items -->
          <ScrollViewer x:Name="PageItems" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24">
              <TextBlock Style="{StaticResource H1}" Text="Altar Items"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,16"
                         Text="Animated custom items. In game press F2 &gt; Items &gt; Altar to spawn them, or F4 and type: give &lt;name&gt;. Combos: F2 &gt; Combos."/>
              <ItemsControl x:Name="ItemGrid">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:ItemVM}">
                    <Border Width="118" Height="118" Margin="0,0,10,10" CornerRadius="12" BorderThickness="1"
                            BorderBrush="{StaticResource B.Border}" Background="{StaticResource B.Card}"
                            RenderTransformOrigin="0.5,0.5" ToolTip="{Binding Name}">
                      <Border.RenderTransform>
                        <ScaleTransform/>
                      </Border.RenderTransform>
                      <Border.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.07" Duration="0:0:0.18" EasingFunction="{StaticResource Ease}"/>
                              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.07" Duration="0:0:0.18" EasingFunction="{StaticResource Ease}"/>
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
                              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </Border.Triggers>
                      <StackPanel VerticalAlignment="Center">
                        <Image Source="{Binding Image}" Width="56" Height="56" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{StaticResource B.Sub}" Margin="6,8,6,0"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="Hotkeys" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,10"/>
              <Border Style="{StaticResource Card}" HorizontalAlignment="Left" MinWidth="560">
                <ItemsControl x:Name="HotkeyList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="60"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="6" Background="{StaticResource B.CardHi}" BorderBrush="{StaticResource B.Border}"
                                BorderThickness="1,1,1,3" Padding="8,2" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding Item1}" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" FontSize="12"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Item2}" Foreground="{StaticResource B.Sub}" FontSize="13" VerticalAlignment="Center"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Settings -->
          <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24" MaxWidth="820" HorizontalAlignment="Left">
              <TextBlock Style="{StaticResource H1}" Text="Settings"/>
              <TextBlock Style="{StaticResource Sub}" Text="Where Altar looks for The Binding of Isaac, and how the app behaves." Margin="0,4,0,16"/>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Game folder" FontSize="12" Foreground="{StaticResource B.Dim}"/>
                  <TextBlock x:Name="GamePathText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,12"/>
                  <WrapPanel>
                    <Button Style="{StaticResource Btn.Accent}" Tag="&#xE8DA;" Content="Change..." Click="ChangeGame_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Btn}" Tag="&#xE838;" Content="Open game folder" Click="OpenGame_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Btn}" Tag="&#xE8B7;" Content="Open Altar data" Click="OpenData_Click"/>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="20" Foreground="{StaticResource B.Accent}"/>
                  <StackPanel Grid.Column="1" Margin="16,0">
                    <TextBlock Text="Clipboard link" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="12.5" Text="While this app is open, anything you copy can be pasted into the in-game console with Ctrl+V."/>
                  </StackPanel>
                  <ToggleButton x:Name="ClipSwitch" Grid.Column="2" Style="{StaticResource Switch}" Click="ClipSwitch_Click"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="20" Foreground="{StaticResource B.Accent}"/>
                  <StackPanel Grid.Column="1" Margin="16,0">
                    <TextBlock Text="Auto-update" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AutoUpdateText" Style="{StaticResource Sub}" FontSize="12.5"/>
                  </StackPanel>
                  <Button x:Name="CheckNowButton" Grid.Column="2" Style="{StaticResource Btn}" Content="Check now" Click="CheckNow_Click" Margin="0,0,16,0" VerticalAlignment="Center"/>
                  <ToggleButton x:Name="AutoSwitch" Grid.Column="3" Style="{StaticResource Switch}" Click="AutoSwitch_Click"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="20" Foreground="{StaticResource B.Green}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                  <StackPanel Grid.Column="1" Margin="16,0">
                    <TextBlock Text="Safe mode" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="12.5"
                               Text="Runs played with mods don't count. When Isaac starts with mods enabled, Altar copies your save files; when Isaac closes they go back, so unlocks, stats, streaks and saved runs from that session are undone. Keep Altar open while you play."/>
                    <TextBlock x:Name="SafeStatus" FontSize="12" Foreground="{StaticResource B.Dim}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource Btn}" Tag="&#xE838;" ToolTip="Open safe mode folder (snapshot and undone saves)"
                          Click="OpenSafe_Click" Margin="0,0,16,0" VerticalAlignment="Center"/>
                  <ToggleButton x:Name="SafeSwitch" Grid.Column="3" Style="{StaticResource Switch}" Click="SafeSwitch_Click"/>
                </Grid>
              </Border>

              <TextBlock x:Name="OtherInstallsTitle" Text="Other Isaac installs found" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8"/>
              <ItemsControl x:Name="OtherInstalls">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="14,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding}" Foreground="{StaticResource B.Sub}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Green}" Content="Use this" CommandParameter="{Binding}" Click="UseInstall_Click" Margin="10,0,0,0"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock x:Name="VersionText" Foreground="{StaticResource B.Dim}" FontSize="12" Margin="0,20,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- ===== details pane ===== -->
        <Border x:Name="DetailsPane" Grid.Column="2" Background="{StaticResource B.Panel}">
          <Grid>
            <StackPanel x:Name="DetailsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="34" Foreground="{StaticResource B.Dim}" HorizontalAlignment="Center"/>
              <TextBlock Text="Select a mod to see its details" Foreground="{StaticResource B.Dim}" Margin="0,12,0,0"/>
            </StackPanel>
            <ScrollViewer x:Name="DetailsBody" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel Margin="22,28,22,22">
                <Grid Width="112" Height="112">
                  <Border CornerRadius="20" Background="{Binding TileBrush}">
                    <TextBlock Text="{Binding Initial}" FontSize="48" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Border CornerRadius="20">
                    <Border.Background>
                      <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                    </Border.Background>
                  </Border>
                  <Grid.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
                  </Grid.Effect>
                </Grid>
                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource F.Display}" FontSize="20" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,2"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                  <TextBlock Text="{Binding Version}" Foreground="{StaticResource B.Green}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Border CornerRadius="10" Padding="9,2" Margin="10,0,0,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#33ff5a66"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Enabled}" Value="True">
                            <Setter Property="Background" Value="#3359ff80"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock FontSize="11" FontWeight="Bold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="DISABLED"/>
                          <Setter Property="Foreground" Value="{StaticResource B.Red}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                              <Setter Property="Text" Value="ENABLED"/>
                              <Setter Property="Foreground" Value="{StaticResource B.Green}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding FullDescription}" Style="{StaticResource Sub}" Margin="0,16,0,0" LineHeight="19"/>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,10">
                  <StackPanel>
                    <StackPanel.Resources>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Margin" Value="0,3"/>
                      </Style>
                    </StackPanel.Resources>
                    <Grid>
                      <TextBlock Text="Folder" Foreground="{StaticResource B.Dim}"/>
                      <TextBlock Text="{Binding Folder}" HorizontalAlignment="Right" FontWeight="SemiBold" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Grid>
                      <TextBlock Text="Files" Foreground="{StaticResource B.Dim}"/>
                      <TextBlock Text="{Binding FilesText}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid>
                      <TextBlock Text="Size" Foreground="{StaticResource B.Dim}"/>
                      <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid>
                      <TextBlock Text="Type" Foreground="{StaticResource B.Dim}"/>
                      <TextBlock Text="{Binding Kind}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid x:Name="WorkshopRow">
                      <TextBlock Text="Workshop" Foreground="{StaticResource B.Dim}"/>
                      <TextBlock Text="{Binding WorkshopId}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <UniformGrid Columns="3" Margin="0,16,0,0">
                  <Button x:Name="DetailToggle" Click="DetailToggle_Click" Margin="0,0,4,0">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource Btn.Green}">
                        <Setter Property="Content" Value="Enable"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Enabled}" Value="True">
                            <Setter Property="Content" Value="Disable"/>
                            <Setter Property="Background" Value="{StaticResource B.CardHi}"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button Style="{StaticResource Btn}" Content="Folder" Click="DetailFolder_Click" Margin="4,0"/>
                  <Button Style="{StaticResource Btn.Danger}" Content="Uninstall" Click="DetailUninstall_Click" Margin="4,0,0,0"/>
                </UniformGrid>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- ===== drop overlay ===== -->
      <Border x:Name="DropOverlay" Grid.Row="1" Grid.RowSpan="2" Background="#cc120d1c" Visibility="Collapsed" IsHitTestVisible="False">
        <Border Margin="40" CornerRadius="18" BorderThickness="2" BorderBrush="{StaticResource B.Accent}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="54" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center"/>
            <TextBlock Text="Drop to install" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Border>

      <!-- ===== toast ===== -->
      <Border x:Name="ToastCard" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
              CornerRadius="10" Background="{StaticResource B.CardHi}" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
              Padding="16,12" Opacity="0" IsHitTestVisible="False" MaxWidth="520">
        <Border.RenderTransform>
          <TranslateTransform/>
        </Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="ToastDot" Width="10" Height="10" VerticalAlignment="Center"/>
          <TextBlock x:Name="ToastText" Margin="12,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
